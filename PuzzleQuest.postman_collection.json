    {
      "name": "04. University Banana API Interoperability",
      "item": [
        {
          "name": "Fetch Mystery Challenge from Banana API",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/banana/challenge",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "banana",
                "challenge"
              ]
            },
            "description": "Proxies request to https://marcconrad.com/uob/banana/api.php?out=json. Returns challenge question image URL and securely caches solution on the server. Automatically saves {{challengeId}} collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Challenge object present with question image\", function () {",
                  "    pm.expect(json.challenge).to.be.an(\"object\");",
                  "    pm.expect(json.challenge.question).to.include(\"http\");",
                  "});",
                  "pm.test(\"Expected solution is NOT leaked to client\", function () {",
                  "    pm.expect(json.challenge.solution).to.be.undefined;",
                  "});",
                  "if (json.challenge && json.challenge.challengeId) {",
                  "    pm.collectionVariables.set(\"challengeId\", json.challenge.challengeId);",
                  "    console.log(\"Cached challengeId:\", json.challenge.challengeId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Banana Challenge Answer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"answer\": 7,\n  \"levelId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/banana/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "banana",
                "verify"
              ]
            },
            "description": "Validates answer against server cache. If correct, awards bonus score, bonus relic fragments, and increments bananaSolved count."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Verification endpoint responds (200 or 400)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Returns validation result boolean\", function () {",
                  "    pm.expect(json).to.have.property(\"isCorrect\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
