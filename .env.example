# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# If local MongoDB is not running, PuzzleQuest automatically activates
# the built-in resilient in-memory database store for seamless testing.
MONGODB_URI=mongodb://localhost:27017/puzzlequest

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=puzzlequest_super_secret_jwt_key_2026_enterprise

# Banana API Base URL (University of Bedfordshire)
BANANA_API_URL=https://marcconrad.com/uob/banana/api.php
BANANA_API_TIMEOUT_MS=6000
